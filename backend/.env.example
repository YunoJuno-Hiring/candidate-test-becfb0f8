# Copy to backend/.env and uncomment what you need to change. Every value shown is the default in config/settings.py.

# Django
# DJANGO_SECRET_KEY=dev-secret-key-not-for-production
# DEBUG=False

# Database (docker compose's Postgres)
# DB_NAME=yunojuno
# DB_USER=yunojuno
# DB_PASSWORD=yunojuno
# DB_HOST=localhost
# DB_PORT=5432

# Email (Mailpit)
# EMAIL_HOST=localhost
# EMAIL_PORT=1025

# Webhooks
# Hosts exempt from the https and SSRF checks. Defaults to localhost,webhook-receiver when DEBUG, otherwise none.
# WEBHOOK_DEV_ALLOWED_HOSTS=localhost,webhook-receiver
# Version stamped on every payload envelope.
# WEBHOOK_PAYLOAD_VERSION=1
